# ==========================================
# Cardio Project - Git Ignore Rules
# Full-Stack: Python Backend + React/Vite Frontend
# ==========================================

# ------------------------------------------
# Environment & Secrets (Never commit credentials)
# ------------------------------------------
.env
.env.*
!.env.example
*.env

# ------------------------------------------
# Python Backend (FastAPI / Flask / ML)
# ------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
conda_env/

# Jupyter Notebook & Data Science Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Pytest / Unit Test / Coverage reports
.pytest_cache/
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# SQLite / Local Databases
*.db
*.sqlite3
project_filebrowser.db

# Large Model / Dataset artifacts (uncomment if models are tracked via DVC / S3 / HuggingFace)
# *.pkl
# *.h5
# *.onnx
# *.pt
# *.pth
# *.joblib

# ------------------------------------------
# Frontend (Node.js / React / Vite)
# ------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Production Outputs
dist/
dist-ssr/
build/
out/
.vite/

# Frontend testing & coverage
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vercel / Netlify Deployment Artifacts
.vercel
.netlify

# ------------------------------------------
# Operating System & IDE Caches
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml

# Other editors
*.swp
*.swo
*~
*.bak
